* {
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: #cdd6f4;
    margin: 0;
    padding: 0;
}

window {
    background-color: #1e1e2e;
    border: 2px;
    border-color: #89b4fa;
    border-radius: 0px;
    width: 520px;
    padding: 12px;
}

mainbox {
    spacing: 8px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: #313244;
    border-radius: 0px;
    padding: 6px 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: #89b4fa;
    margin: 0px 8px 0px 0px;
}

entry {
    placeholder: "Buscar aplicación...";
    placeholder-color: #6c7086;
    text-color: #cdd6f4;
}

listview {
    lines: 7;
    columns: 1;
    fixed-height: false;
    spacing: 4px;
    cycle: true;
}

element {
    padding: 6px 10px;
    border-radius: 0px;
    spacing: 10px;
    background-color: transparent;
    children: [ element-icon, element-text ];
}

element-icon {
    size: 28px;
}

element-text {
    vertical-align: 0.5;
    text-color: #cdd6f4;
}

element selected {
    background-color: #89b4fa;
}

element selected element-text {
    text-color: #11111b;
}

element selected element-icon {
    size: 28px;
}
