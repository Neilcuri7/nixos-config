color-link default "{{ colors.on_background.default.hex }},default"
color-link comment "{{ colors.outline.default.hex }},default"
color-link identifier "{{ colors.error.default.hex }},default"
color-link constant "{{ colors.tertiary.default.hex }},default"
color-link constant.string "{{ colors.secondary.default.hex }},default"
color-link constant.number "{{ colors.tertiary.default.hex }},default"
color-link statement "{{ colors.primary.default.hex }},default"
color-link symbol "{{ colors.secondary.default.hex }},default"
color-link preproc "{{ colors.primary.default.hex }},default"
color-link type "{{ colors.primary.default.hex }},default"
color-link special "{{ colors.secondary.default.hex }},default"
color-link underlined "{{ colors.primary.default.hex }},default"
color-link error "bold {{ colors.error.default.hex }},default"
color-link todo "bold {{ colors.primary.default.hex }},default"
color-link statusline "{{ colors.on_surface.default.hex }},{{ colors.surface_variant.default.hex }}"
color-link tabbar "{{ colors.on_surface.default.hex }},{{ colors.surface_variant.default.hex }}"
color-link line-number "{{ colors.outline.default.hex }},default"
color-link current-line-number "bold {{ colors.primary.default.hex }},default"
color-link cursor-line "{{ colors.surface_variant.default.hex }},default"
color-link color-column "{{ colors.surface_variant.default.hex }},default"
color-link divider "{{ colors.outline.default.hex }},default"
color-link indent-char "{{ colors.outline.default.hex }},default"
