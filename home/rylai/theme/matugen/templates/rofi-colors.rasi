* {
    background:  #{{ colors.surface.default.hex_stripped }}ee;
    selected:        #{{ colors.surface_variant.default.hex_stripped }}dd;
    selected-accent: #{{ colors.primary.default.hex_stripped }}40;
    accent:          #{{ colors.primary.default.hex_stripped }};
    border-col:      #{{ colors.outline.default.hex_stripped }};
    text:            #{{ colors.on_surface.default.hex_stripped }};
    placeholder:     #{{ colors.on_surface.default.hex_stripped }}55;
}
