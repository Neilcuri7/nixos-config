* {
    background:      {{background}}e6;
    input-bg:        rgba({{color4 | red}}, {{color4 | green}}, {{color4 | blue}}, 0.12);
    selected-accent: rgba({{color4 | red}}, {{color4 | green}}, {{color4 | blue}}, 0.20);
    accent:          {{color12}};
    border-col:      rgba({{color4 | red}}, {{color4 | green}}, {{color4 | blue}}, 0.35);
    text:            {{foreground}};
    placeholder:     {{color7}}80;
}
