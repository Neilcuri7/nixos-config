color-link default "{{foreground}},default"
color-link comment "{{color8}},default"
color-link identifier "{{color1}},default"
color-link constant "{{color3}},default"
color-link constant.string "{{color2}},default"
color-link constant.number "{{color3}},default"
color-link statement "{{color5}},default"
color-link symbol "{{color6}},default"
color-link preproc "{{color4}},default"
color-link type "{{color4}},default"
color-link special "{{color6}},default"
color-link underlined "{{color4}},default"
color-link error "bold {{color1}},default"
color-link todo "bold {{color3}},default"
color-link statusline "{{foreground}},{{color8}}"
color-link tabbar "{{foreground}},{{color8}}"
color-link line-number "{{color8}},default"
color-link current-line-number "bold {{color4}},default"
color-link cursor-line "{{color8}},default"
color-link color-column "{{color8}},default"
color-link divider "{{color8}},default"
color-link indent-char "{{color8}},default"
