@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @text;
    margin: 0;
    padding: 0;
}

window {
    background-color: @background;
    border: 1px;
    border-color: @border-col;
    border-radius: 16px;
    width: 520px;
    padding: 0;
}

mainbox {
    spacing: 0;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @input-bg;
    border: 0 0 1px 0;
    border-color: @border-col;
    border-radius: 16px 16px 0 0;
    padding: 14px 16px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 11.5";
    margin: 0px 8px 0px 0px;
}

entry {
    placeholder: "Buscar...";
    placeholder-color: @placeholder;
    text-color: @text;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    padding: 8px;
    spacing: 2px;
    cycle: true;
}

element {
    padding: 10px;
    border-radius: 8px;
    spacing: 12px;
    background-color: transparent;
    children: [ element-icon, element-text ];
}

element-icon {
    size: 26px;
}

element-text {
    vertical-align: 0.5;
    text-color: @text;
}

element selected {
    background-color: @selected-accent;
    border: 1px;
    border-color: @accent;
}

element selected element-text {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 11";
}
